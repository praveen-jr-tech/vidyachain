# UniCred - Environment Configuration Example
# Copy this file to .env before starting the services in production.
# IMPORTANT: Placeholders only. Never commit real production secrets.

# Backend Configuration
UNICRED_ENV=development
UNICRED_DB=./backend/unicred.db
UNICRED_TOKEN_SECRET=change-this-to-a-cryptographically-secure-random-secret-key-in-production

# Server Host & Port
UNICRED_HOST=127.0.0.1
UNICRED_PORT=8000

# SecureVault Settings
UNICRED_VAULT_DIR=./securevault/storage
UNICRED_MAX_UPLOAD_MB=5

# Optional ClamAV Antivirus Daemon (Production only)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Frontend Configuration (Vite)
VITE_API_URL=http://127.0.0.1:8000
